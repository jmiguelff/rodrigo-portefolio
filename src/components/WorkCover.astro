---
import { Picture } from "astro:assets";

interface Props {
  color: string;
  title: string;
  label?: string | undefined;
  name?: string | undefined;
  local?: string | undefined;
  src: ImageMetadata;
  href?: string | undefined;
  alt: string;
  priority?: boolean | undefined;
}

const {
  title,
  color,
  label,
  name,
  href,
  src,
  alt = "No alt text provided",
  local,
  priority = false,
} = Astro.props;
---

<div class="article-wrapper">
  <div class="image-wrapper">
    <div class="title-wrapper">
      <p class="title-text">
        <span>{title}</span>{label}
        <span class="italic">{name}</span>{local}
      </p>
    </div>
    <a href={href}>
      <Picture
        src={src}
        formats={["avif", "webp"]}
        widths={[480, 768, 1024, 1440, 1920]}
        sizes="(max-width: 576px) 100vw, 50vw"
        quality="high"
        priority={priority}
        alt={alt}
        class="image-cover"
      />
    </a>
  </div>
</div>

<style define:vars={{ color }}>
  .article-wrapper {
    height: 100%;
  }

  .image-wrapper {
    position: relative;
    overflow: hidden;
    background: #eeeeec;
  }

  .image-wrapper:hover p {
    filter: blur(1px);
  }

  .title-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;

    top: 0.3rem;
    position: absolute;
  }

  .title-text {
    color: var(--color);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    margin: 0;
  }

  span {
    color: var(--color);
    font-family: var(--font-brand);
    font-size: var(--text-sm);
    margin-right: 0.3rem;
  }

  .italic {
    color: var(--color);
    font-family: var(--font-italic);
    font-size: var(--text-sm);
    margin: 0;
  }

  .image-wrapper a {
    text-decoration: none;
    display: block;
    height: 100%;
    width: 100%;
  }

  .image-cover {
    display: block;
    width: 100%;
    height: auto;
  }

  @media screen and (max-width: 576px) {
    .title-text {
      font-size: var(--text-xxs);
    }

    span {
      font-size: var(--text-xxs);
      margin-right: 0.125rem;
    }

    .italic {
      font-size: var(--text-xxs);
    }

    .title-wrapper {
      top: 0.2rem;
    }
  }
</style>
