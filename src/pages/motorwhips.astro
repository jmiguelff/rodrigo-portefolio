---
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from "../layouts/BaseLayout.astro";

// Work page component
import WorkComponent from "../components/WorkPage.astro";

// Work images metadata
import WorkImages from "../data/work-images.ts";

const materials = ["wiper motors;", "red led strip;", "DC power supply."];

const image1 = {
  src: WorkImages.motorwhips.gallery[0],
  alt: "Portrait light drag.",
};

const image2 = {
  src: WorkImages.motorwhips.gallery[1],
  alt: "Close up of the windscreen wiper.",
};

const image3 = {
  src: WorkImages.motorwhips.gallery[2],
  alt: "Geral shot of piece.",
};
---

<BaseLayout>
  <WorkComponent
    name="motor whips"
    year="2023"
    materials={materials}
    description="Kinetic light piece."
    location="Porto."
    imageLink1={image1}
    imageLink2={image2}
    imageLink3={image3}
    videoLink="https://player.vimeo.com/video/903082743?h=8e70207b61&title=0&byline=0&portrait=0"
  />
</BaseLayout>
