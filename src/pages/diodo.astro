---
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from "../layouts/BaseLayout.astro";

// Work page component
import WorkComponent from "../components/WorkPage.astro";

// Work images metadata
import WorkImages from "../data/work-images.ts";

const materials = ["laser diodes;", "speakers;", "mirror;", "latex."];

const image1 = {
  src: WorkImages.diodo.gallery[0],
  alt: "Close up of the laser.",
};

const image2 = {
  src: WorkImages.diodo.gallery[1],
  alt: "Shot of the laser.",
};

const image3 = {
  src: WorkImages.diodo.gallery[2],
  alt: "Ambient shot of the piece.",
};
---

<BaseLayout>
  <WorkComponent
    name="díodo"
    year="2020"
    materials={materials}
    description="Audio-reactive laser projection in a rave context."
    location="Ácida, Porto."
    imageLink1={image1}
    imageLink2={image2}
    imageLink3={image3}
    videoLink="https://player.vimeo.com/video/409559819?h=f08e0eb980&title=0&byline=0&portrait=0"
  />
</BaseLayout>
