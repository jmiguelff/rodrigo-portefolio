---
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from "../layouts/BaseLayout.astro";

// Work page component
import WorkComponent from "../components/WorkPage.astro";

// Work images metadata
import WorkImages from "../data/work-images.ts";

const materials = [
  "weights;",
  "construction safety net;",
  "steel wire rope;",
  "video projector;",
  "AC motor.",
];

const image1 = {
  src: WorkImages.wave.gallery[0],
  alt: "Detail of the wave piece.",
};

const image2 = {
  src: WorkImages.wave.gallery[1],
  alt: "Geral shot of piece, blue lighting.",
};

const image3 = {
  src: WorkImages.wave.gallery[2],
  alt: "Geral shot of piece, red lighting.",
};
---

<BaseLayout>
  <WorkComponent
    name="wave"
    year="2019"
    materials={materials}
    description="Installation in a rave context, collaboration with Gil Peixoto."
    location="Ácida, Porto."
    imageLink1={image1}
    imageLink2={image2}
    imageLink3={image3}
    videoLink="https://player.vimeo.com/video/342460942?h=886e4e6a50&title=0&byline=0&portrait=0"
  />
</BaseLayout>
