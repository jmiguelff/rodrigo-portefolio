---
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from "../layouts/BaseLayout.astro";

// Work page component
import WorkComponent from "../components/WorkPage.astro";

// Work images metadata
import WorkImages from "../data/work-images.ts";

const materials = [
  "cloth;",
  "mirror;",
  "DC motors;",
  "pine beam;",
  "found objects.",
];

const image1 = {
  src: WorkImages.organismovivo.gallery[0],
  alt: "Wall structure.",
};

const image2 = {
  src: WorkImages.organismovivo.gallery[1],
  alt: "Detail of the wall structure.",
};

const image3 = {
  src: WorkImages.organismovivo.gallery[2],
  alt: "Robot on moving on the wall.",
};
---

<BaseLayout>
  <WorkComponent
    name="organismo vivo"
    year="2019"
    materials={materials}
    description="A machine that displays free wil and interacts within its restricted space."
    location="TETRIS III, Pérola Negra, Porto."
    imageLink1={image1}
    imageLink2={image2}
    imageLink3={image3}
    videoLink="https://player.vimeo.com/video/342459879?h=67771e246b&title=0&byline=0&portrait=0"
  />
</BaseLayout>
