---
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from "../layouts/BaseLayout.astro";

// Work articles component
import WorkCover from "../components/WorkCover.astro";

// Import work images metadata
import WorkImages from "../data/work-images.ts";
---

<BaseLayout>
  <section class="2023">
    <div class="year-label">
      <p>2023</p>
    </div>
    <article>
      <WorkCover
        title="motorwhips"
        color="#FFFFFF"
        href="/motorwhips/"
        label="installation, "
        local="Porto"
        src={WorkImages.motorwhips.cover}
        alt="Overview of the motorwhips piece."
        priority={true}
      />
    </article>
  </section>
  <section class="2022">
    <div class="year-label">
      <p>2022</p>
    </div>
    <article>
      <WorkCover
        title="motorshell"
        color="#FFFFFF"
        href="/motorshell/"
        label="installation, "
        name="Viagem ao Anti-Centro"
        local=", Espaço Ócio, Porto"
        src={WorkImages.motorshell.cover}
        alt="Overview of the exhibition at Ócio."
      />
    </article>
  </section>
  <section class="2020">
    <div class="year-label">
      <p>2020</p>
    </div>
    <article>
      <WorkCover
        title="moving cloth"
        color="#FFFFFF"
        href="/movingcloth/"
        label="installation, "
        local="Limina, Porto"
        src={WorkImages.movingcloth.cover}
        alt="Shape with cloth on top."
      />
    </article>
    <article>
      <WorkCover
        title="presença luminosa mutável"
        color="var(--black-50)"
        href="/presencamutavel/"
        name="Site-specific"
        local=", Limina, Porto"
        src={WorkImages.presencaluminosa.cover}
        alt="Lights from the ceiling."
      />
    </article>
    <article>
      <WorkCover
        title='"(",'
        color="var(--black-50)"
        href="/videoinstalacao/"
        label="video installation, Galeria Dentro, Porto"
        src={WorkImages.videoinstalacao.cover}
        alt="Wire in the middle of the room."
      />
    </article>
    <article>
      <WorkCover
        title="mutable presence"
        color="var(--black-50)"
        href="/videoinstalacao/"
        label="video installation,"
        local="Galeria Dentro, Porto"
        src={WorkImages.presencamutavel.cover}
        alt="Shape getting out of a wall."
      />
    </article>
    <article>
      <WorkCover
        title="díodo"
        color="#FFFFFF"
        label="installation, "
        local="Ácida, Porto"
        href="/diodo/"
        src={WorkImages.diodo.cover}
        alt="Dark image of diodo installation."
      />
    </article>
    <article>
      <WorkCover
        title="duo"
        color="var(--black-50)"
        label="collective exhibition, "
        name='"Finding a CLICK in a haystack"'
        local=", Centro Comercial de Cedofeita, Porto"
        href="/duo/"
        src={WorkImages.duo.cover}
        alt="Duo exhibition machines."
      />
    </article>
  </section>
  <section class="2019">
    <div class="year-label">
      <p>2019</p>
    </div>
    <article>
      <WorkCover
        title="dune"
        color="#FFFFFF"
        label="installation"
        name='"With Grandpa&apos;s Lab"'
        local=", Fisga, Porto"
        href="/dune/"
        src={WorkImages.dune.cover}
        alt="Matrix of light on textile."
      />
    </article>
    <article>
      <WorkCover
        title="wave"
        color="#FFFFFF"
        href="/wave/"
        label="installation, collaboration with Gil Peixoto"
        local=", Ácida, Porto"
        src={WorkImages.wave.cover}
        alt="A dark and abstract scenary."
      />
    </article>
    <article>
      <WorkCover
        title="organismo vivo"
        color="var(--black-50)"
        href="/organismovivo/"
        label="installation, "
        local="TETRIS III, Pérola Negra, Porto"
        src={WorkImages.organismovivo.cover}
        alt="Barbie up the wall."
      />
    </article>
    <article>
      <WorkCover
        title="mechanic drawing"
        color="var(--black-50)"
        href="/mechanicdrawing/"
        label="installation, "
        local="TETRIS II, Porto"
        src={WorkImages.mechanicdrawing.cover}
        alt="Drawing robot."
      />
    </article>
  </section>
  <section class="2018">
    <div class="year-label">
      <p>2018</p>
    </div>
    <article>
      <WorkCover
        title="sound machine"
        color="var(--black-50)"
        href="/soundmachine/"
        label="installation"
        src={WorkImages.soundmachine.cover}
        alt="Wooden robot in an angle."
      />
    </article>
  </section>
</BaseLayout>

<style>
  .year-label {
    padding: 0;
    margin-right: 7.5rem;
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    text-align: right;
  }

  .year-label p {
    padding: 0;
    margin: 0;
    color: var(--black-50);
    font-family: var(--font-brand);
    font-weight: 600;
    font-size: 1.625rem;
  }

  @media screen and (max-width: 576px) {
    .year-label {
      padding: 0;
      margin-right: 1rem;
      margin-bottom: 0.2rem;
      margin-top: 0.2rem;
    }

    .year-label p {
      font-size: 1rem;
    }
  }
</style>
